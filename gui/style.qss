QWidget {
    font-family: "Microsoft YaHei UI", "Segoe UI", "Source Han Sans", "Noto Sans CJK SC", sans-serif;
    font-size: 10pt;
}

QMainWindow, QDialog {
    background-color: #f0f0f0;
}

QGroupBox {
    border: 1px solid #dcdcdc;
    border-radius: 5px;
    margin-top: 1ex;
    font-weight: bold;
    background-color: #ffffff;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
}

#StatusGroupBox {
    margin-top: 18px;
}

#StatusGroupBox::title {
    left: 0px;
}

QListWidget {
    border: 1px solid #dcdcdc;
    border-radius: 5px;
    padding: 5px;
    background-color: #ffffff;
}

QListWidget::item {
    padding: 8px;
    border-radius: 3px;
}

QListWidget::item:hover {
    background-color: #e6f2ff;
}

QListWidget::item:selected {
    background-color: #cce5ff;
    color: #000;
    border: 1px solid #007bff;
}

QTableWidget {
    border: 1px solid #dcdcdc;
    border-radius: 5px;
    background-color: #ffffff;
    gridline-color: #e8e8e8;
}

QHeaderView::section {
    background-color: #f8f9fa;
    padding: 4px;
    border: 1px solid #dcdcdc;
    font-weight: bold;
}

QTextEdit {
    background-color: #ffffff;
    border: 1px solid #dcdcdc;
    border-radius: 5px;
    color: #444;
}

#ManageButton {
    padding: 4px 10px;
    font-size: 9pt;
    font-weight: normal;
    background-color: #007bff;
}
#ManageButton:hover {
    background-color: #0056b3;
}

QPushButton {
    background-color: #007bff;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 4px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #0056b3;
}

QPushButton:pressed {
    background-color: #004085;
}

QPushButton:disabled {
    background-color: #c0c0c0;
}

QLineEdit, QComboBox {
    padding: 5px;
    border: 1px solid #ccc;
    border-radius: 4px;
    background-color: #fff;
}

QLineEdit:read-only {
    background-color: #e9ecef;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left-width: 1px;
    border-left-color: #ccc;
    border-left-style: solid;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
}

QStatusBar {
    background-color: #f8f9fa;
    border-top: 1px solid #dcdcdc;
}

QStatusBar::item {
    border: none;
}

h4 {
    margin-bottom: 5px;
}